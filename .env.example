# ==============================================================================
# KONFIGURASI KAMERA RTSP (SLICE PARAMETERS)
# ==============================================================================
RTSP_USER=admin
RTSP_PASS=bismillah123
RTSP_HOST=192.168.77.209
RTSP_PORT=554

# ------------------------------------------------------------------------------
# PILIH PATH STREAM (PILIH SALAH SATU SESUAI MERK KAMERA CCTV):
# ------------------------------------------------------------------------------
# 1. Hikvision / Hilook / Ezviz:
#    Mainstream (1080p/4K) : /Streaming/Channels/101
#    Substream  (720p/360p): /Streaming/Channels/102
#
# 2. Dahua / IMOU / KBVision:
#    Mainstream (1080p/4K) : /cam/realmonitor?channel=1&subtype=0
#    Substream  (720p/360p): /cam/realmonitor?channel=1&subtype=1
#
# 3. TP-Link Tapo / Vigi:
#    Mainstream (1080p/4K) : /stream1
#    Substream  (720p/360p): /stream2
#
# 4. Uniview (UNV):
#    Mainstream (1080p/4K) : /unicast/c1/s0/live
#    Substream  (720p/360p): /unicast/c1/s1/live
#
# 5. Generic ONVIF / Xiongmai (XM) / Bardi:
#    Mainstream (1080p/4K) : /live/ch0   atau /h264Preview_01_main
#    Substream  (720p/360p): /live/ch1   atau /h264Preview_01_sub
# ------------------------------------------------------------------------------

# Aktifkan Substream (misalnya untuk Dahua / IMOU):
RTSP_STREAM_PATH=/cam/realmonitor?channel=1&subtype=1

# URL Final yang dibaca oleh sistem (otomatis menggabungkan slice di atas):
CAMERA_SOURCE=rtsp://${RTSP_USER}:${RTSP_PASS}@${RTSP_HOST}:${RTSP_PORT}${RTSP_STREAM_PATH}

# ==============================================================================
# KONFIGURASI BACKEND API INTEGRATION
# ==============================================================================
BACKEND_API_URL=http://localhost:3000/api/v1/attendance
ML_API_KEY=your-ml-api-key-change-in-production

# ==============================================================================
# KONFIGURASI CLOUDINARY (SYNC FOTO EMPLOYEE DARI CLOUD)
# ==============================================================================
# Opsi 1: Format Single URL (Opsional)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Opsi 2: Parameter Terpisah
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=employees

# Path lokal untuk penyimpanan cache foto & embedding
ENROLL_DATA_PATH=data/enroll
EMBEDDING_FILE_PATH=data/embeddings.npz
